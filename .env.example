# Values below match a local ExperimentLens stack started with `docker compose up`
# (see https://experimentlens.imsi.athenarc.gr/docs, "Build the app").

# MLflow tracking server -- the same one ExperimentLens reads from.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Only if your MLflow server requires a token (ExperimentLens' MLFLOW_TRACKING_TOKEN).
# MLFLOW_TRACKING_TOKEN=

# Langfuse: use the SAME key pair as ExperimentLens' root .env, so the traces land
# in the project ExperimentLens reads.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Optional: the Langfuse project id. If unset, it is looked up from the keys above.
# LANGFUSE_PROJECT_ID=

# Optional: also send a copy of every trace to another OpenTelemetry tool (Phoenix,
# Logfire, Honeycomb, Datadog, ...). Langfuse keeps getting them too. Put any API key
# in OTEL_EXPORTER_OTLP_HEADERS, e.g. "x-honeycomb-team=<key>".
# EXPERIMENTLENS_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# Optional: default model for call_llm() and for LLM-as-judge (any litellm model
# string). EXPERIMENTLENS_MODEL also accepts the docs' name LLM_MODEL. Both fall back
# to ollama/llama3.2; the judge falls back to EXPERIMENTLENS_MODEL.
# EXPERIMENTLENS_MODEL=ollama/llama3.2
# EXPERIMENTLENS_JUDGE_MODEL=openai/gpt-4o-mini

# Only needed if you point call_llm() at a cloud model instead of local Ollama.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Where local Ollama runs (used for ollama/* models).
OLLAMA_API_BASE=http://localhost:11434
